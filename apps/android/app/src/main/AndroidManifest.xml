<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application
        android:theme="@style/Theme.AlfieTV"
        android:label="Alfie TV"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:screenOrientation="landscape" android:exported="false" android:supportsPictureInPicture="true" />
        <activity android:name=".LiveTvActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".ContentActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".FavoritesActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".HomeActivity" android:screenOrientation="landscape" android:exported="false" />
        <activity android:name=".LoginActivity" android:screenOrientation="landscape" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
