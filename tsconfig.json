{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@alfie-tv/core/*": ["./packages/core/src/*"],
      "@alfie-tv/ui/*": ["./packages/ui/src/*"]
    }
  }
}
